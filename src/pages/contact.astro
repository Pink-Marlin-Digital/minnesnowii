---
import PageHero from '../components/molecules/PageHero/PageHero.astro';
import SectionHeader from '../components/molecules/SectionHeader/SectionHeader.astro';
import BookingForm from '../components/molecules/FormField/BookingForm.astro';
import Text from '../components/atoms/Text/Text.astro';
import FairCountdown from '../components/FairCountdown.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { createPageSeo } from '../lib/seo';
import content from '../content/pages/contact.json';
import site from '../config/site.json';

const page = createPageSeo({
  id: content.id,
  path: content.path,
  title: content.title,
  description: content.description,
  ogTitle: content.heroTitle,
});
const phoneHref = `tel:${site.business.phone.replace(/[^\d+]/g, '')}`;
---

<SiteLayout page={page}>
  <PageHero title={content.heroTitle} />
  <div class="page-wrap contact-page">
    {content.sections.map((section) => (
      <section class="contact-section">
        <SectionHeader title={section.title} display align="center" />
        {section.body.map((paragraph) => <Text class="muted center">{paragraph}</Text>)}
      </section>
    ))}
    <p class="contact-phone">
      Prefer to talk? <a href={phoneHref}>{site.business.phone}</a>
    </p>
    <section class="booking-section" aria-labelledby="booking-header">
      <h2 id="booking-header" class="booking-title">Book an Event</h2>
      <BookingForm />
    </section>
    <div class="contact-countdown">
      <FairCountdown />
    </div>
  </div>
</SiteLayout>

<style>
  .contact-page {
    display: grid;
    gap: 28px;
    padding: 24px 0 64px;
  }

  .contact-section {
    display: grid;
    gap: 12px;
  }

  .contact-phone {
    margin: 0;
    text-align: center;
    font-weight: 700;
  }

  .contact-phone a {
    color: var(--color-brand-muted);
  }

  .booking-section {
    display: grid;
    gap: 20px;
    padding: 8px 0 16px;
  }

  .booking-title {
    margin: 0;
    color: #03d9ff;
    font-family: var(--font-brand);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 400;
    text-align: center;
    text-shadow: 0.15rem 0.15rem 0.25rem #333;
  }

  .contact-countdown {
    margin-top: 16px;
  }

  :global(.text.center) {
    text-align: center;
  }
</style>
