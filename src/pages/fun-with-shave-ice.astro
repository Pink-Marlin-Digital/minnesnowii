---
import PageHero from '../components/molecules/PageHero/PageHero.astro';
import SectionHeader from '../components/molecules/SectionHeader/SectionHeader.astro';
import InstagramFollowCta from '../components/molecules/InstagramFollowCta/InstagramFollowCta.astro';
import Text from '../components/atoms/Text/Text.astro';
import PhotoGallery from '../components/organisms/PhotoGallery/PhotoGallery.astro';
import FairCountdown from '../components/FairCountdown.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { createPageSeo } from '../lib/seo';
import content from '../content/pages/fun-with-shave-ice.json';

const page = createPageSeo({
  id: content.id,
  path: content.path,
  title: content.title,
  description: content.description,
  ogTitle: content.heroTitle,
});
---

<SiteLayout page={page}>
  <PageHero title={content.heroTitle} />
  <div class="page-wrap fun-page">
    <SectionHeader title={content.headline} display align="center" />
    {content.body.map((paragraph) => <Text class="muted" align="center">{paragraph}</Text>)}
    <PhotoGallery />
    <InstagramFollowCta
      title={content.instagramFollow.title}
      body={content.instagramFollow.body}
      buttonLabel={content.instagramFollow.buttonLabel}
    />
    <FairCountdown />
  </div>
</SiteLayout>

<style>
  .fun-page {
    display: grid;
    gap: 24px;
    padding: 24px 0 64px;
    justify-items: stretch;
  }

  .fun-page :global(.text) {
    text-align: center;
    max-width: 46rem;
    margin-inline: auto;
  }
</style>
