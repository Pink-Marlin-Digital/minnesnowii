---
import Text from '../components/atoms/Text/Text.astro';
import Heading from '../components/atoms/Heading/Heading.astro';
import Button from '../components/atoms/Button/Button.astro';
import FairCountdown from '../components/FairCountdown.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { createPageSeo } from '../lib/seo';

const page = createPageSeo({
  id: 'thank-you',
  path: '/thank-you/',
  title: 'Message received - Minnesnowii Shave Ice',
  description: 'Thanks for contacting Minnesnowii. We will get back to you soon.',
  robots: 'noindex, follow',
});
---

<SiteLayout page={page}>
  <div class="page-wrap thank-you">
    <Heading level={1}>Message received</Heading>
    <Text>Thanks for contacting Minnesnowii. We will get back to you soon.</Text>
    <Button href="/">Back to the home page</Button>
    <FairCountdown />
  </div>
</SiteLayout>

<style>
  .thank-you {
    display: grid;
    gap: 18px;
    justify-items: start;
    padding: 48px 0 64px;
  }
</style>
