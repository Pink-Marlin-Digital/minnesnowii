---
import googleReviews from '../data/google-reviews.json';
import Button from '../components/atoms/Button/Button.astro';
import GoogleReviews from '../components/organisms/GoogleReviews.astro';
import HomeIntro from '../components/organisms/HomeIntro.astro';
import HomePageSections from '../components/organisms/HomePageSections.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { listPosts } from '../lib/blog';
import { createPageSeo } from '../lib/seo';
import home from '../content/pages/home.json';

const page = createPageSeo({
  id: home.id,
  path: home.path,
  title: home.title,
  description: home.description,
  lcpImage: home.hero.image,
});
const posts = await listPosts();
---

<SiteLayout page={page}>
  <HomeIntro>
    <section class="home-brand">
      <div class="home-brand-fade">
        <img class="home-brand-logo" src={home.brand.logo} alt={home.brand.logoAlt} width="396" height="271" />
        <h2 class="home-brand-headline">{home.brand.headline}</h2>
        <p class="home-brand-subhead">{home.brand.subhead}</p>
      </div>
      <GoogleReviews
        businessName={googleReviews.businessName}
        businessUrl={googleReviews.businessUrl}
        rating={googleReviews.rating}
        reviewCount={googleReviews.reviewCount}
        reviews={googleReviews.reviews}
      />
      <div class="home-actions-row">
        {home.actions.map((action) => (
          <Button href={action.href} title={action.title}>{action.label}</Button>
        ))}
      </div>
    </section>
  </HomeIntro>

  <HomePageSections posts={posts} />
</SiteLayout>

<style>
  .home-actions-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
    margin-top: 24px;
  }

  .home-brand-logo {
    display: block;
    width: min(280px, 70%);
    height: auto;
    margin: 0 auto 12px;
  }
</style>
