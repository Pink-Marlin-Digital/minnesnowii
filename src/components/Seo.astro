---
import type { PageData } from '../lib/pages';

interface Props {
  page: PageData;
}

const { page } = Astro.props;
const origin = (Astro.site ?? new URL('https://minnesnowii.com')).toString().replace(/\/$/, '');

function absoluteUrl(value: string): string {
  if (!value) {
    return `${origin}/wp-content/uploads/2021/07/Artboard-1@2x.png`;
  }
  if (value.startsWith('http://') || value.startsWith('https://')) {
    return value
      .replaceAll('https://minnesnowii.com', origin)
      .replaceAll('http://minnesnowii.com', origin);
  }
  return new URL(value, `${origin}/`).href;
}

const canonical = new URL(page.path, `${origin}/`).href;
const image = absoluteUrl(page.ogImage);
const title = page.ogTitle || page.title;
const description = page.ogDescription || page.description;
const jsonLd = page.jsonLd.map((block) =>
  block
    .replaceAll('https://minnesnowii.com', origin)
    .replaceAll('http://minnesnowii.com', origin)
    .replaceAll('</', '<\\/'),
);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{page.title}</title>
<meta name="description" content={page.description} />
<meta name="robots" content={page.robots || 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
<link rel="canonical" href={canonical} />
<meta property="og:locale" content={page.ogLocale || 'en_US'} />
<meta property="og:type" content={page.ogType || 'website'} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content="Minnesnowii Shave Ice" />
<meta property="og:image" content={image} />
{page.ogImageWidth && <meta property="og:image:width" content={page.ogImageWidth} />}
{page.ogImageHeight && <meta property="og:image:height" content={page.ogImageHeight} />}
<meta property="og:image:alt" content={title} />
<meta name="twitter:card" content={page.twitterCard || 'summary_large_image'} />
<meta name="twitter:site" content={page.twitterSite || '@Minnesnowii'} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={title} />
{
  page.icons.map((icon) => (
    <link rel={icon.rel} href={icon.href} sizes={icon.sizes || undefined} type={icon.type || undefined} />
  ))
}
{jsonLd.map((block) => <script type="application/ld+json" set:html={block} />)}
