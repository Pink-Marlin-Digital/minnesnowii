---
interface Review {
  name: string;
  detail?: string;
  rating: number;
  when: string;
  text: string;
}

interface Props {
  businessName: string;
  businessUrl: string;
  rating: number;
  reviewCount: number;
  reviews: Review[];
}

const {
  businessName,
  businessUrl,
  rating,
  reviewCount,
  reviews,
} = Astro.props;

const ratingLabel = Number.isInteger(rating) ? rating.toFixed(1) : String(rating);
const avatarColors = ['#1a73e8', '#5f6368', '#c2410c', '#188038', '#9334e6'];

const starPath = 'M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z';
---

<section class="google-reviews" aria-label={`Google reviews for ${businessName}`}>
  <a class="google-reviews-summary" href={businessUrl} target="_blank" rel="noopener noreferrer">
    <svg class="google-mark" viewBox="0 0 48 48" width="20" height="20" aria-hidden="true">
      <path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.3 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 8 3.1l5.7-5.7C34.2 6.1 29.4 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.7-.4-3.5z"></path>
      <path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 16 19 12 24 12c3.1 0 5.8 1.2 8 3.1l5.7-5.7C34.2 6.1 29.4 4 24 4 16.3 4 9.6 8.3 6.3 14.7z"></path>
      <path fill="#4CAF50" d="M24 44c5.2 0 10-2 13.6-5.2l-6.3-5.3C29.2 35.1 26.7 36 24 36c-5.3 0-9.7-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z"></path>
      <path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-1.1 3.2-3.5 5.7-6.7 7.1l6.3 5.3C37.4 38.4 44 34 44 24c0-1.3-.1-2.7-.4-3.5z"></path>
    </svg>
    <span class="google-reviews-rating">{ratingLabel}</span>
    <span class="google-stars" aria-hidden="true">
      {Array.from({ length: 5 }, (_, index) => (
        <svg viewBox="0 0 24 24" class={index < Math.round(rating) ? 'is-filled' : ''}>
          <path d={starPath}></path>
        </svg>
      ))}
    </span>
    <span class="sr-only">{ratingLabel} out of 5 stars.</span>
    <span class="google-reviews-count">{reviewCount} Google reviews</span>
    <span class="google-reviews-more">See what others are saying</span>
  </a>
  <ul class="google-reviews-row">
    {reviews.map((review, index) => (
      <li>
        <article class="google-review">
          <header>
            <span
              class="google-avatar"
              style={`background:${avatarColors[index % avatarColors.length]}`}
              aria-hidden="true"
            >
              {review.name.trim().charAt(0).toUpperCase()}
            </span>
            <div>
              <p class="google-review-name">{review.name}</p>
              {review.detail && <p class="google-review-detail">{review.detail}</p>}
            </div>
          </header>
          <p class="google-review-meta">
            <span class="google-stars" aria-hidden="true">
              {Array.from({ length: 5 }, (_, starIndex) => (
                <svg viewBox="0 0 24 24" class={starIndex < review.rating ? 'is-filled' : ''}>
                  <path d={starPath}></path>
                </svg>
              ))}
            </span>
            <span class="sr-only">{review.rating} out of 5 stars.</span>
            <span>{review.when}</span>
          </p>
          <p>{review.text}</p>
        </article>
      </li>
    ))}
  </ul>
</section>

<style>
  .google-reviews {
    max-width: 1080px;
    margin: 8px auto 28px;
    text-align: left;
  }

  .google-reviews-summary {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 10px;
    align-items: center;
    justify-content: center;
    margin: 0 auto 18px;
    color: #202124;
    font-family: Roboto, Arial, sans-serif;
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
  }

  .google-reviews-summary:hover .google-reviews-more,
  .google-reviews-summary:focus-visible .google-reviews-more {
    text-decoration: underline;
  }

  .google-reviews-rating {
    color: #202124;
    font-size: 22px;
    font-weight: 500;
    line-height: 1;
  }

  .google-reviews-count {
    color: #70757a;
    font-weight: 400;
  }

  .google-reviews-more {
    color: #1a73e8;
    font-weight: 500;
  }

  .google-stars {
    display: inline-flex;
    gap: 1px;
  }

  .google-stars svg {
    width: 16px;
    height: 16px;
    fill: #dadce0;
  }

  .google-stars svg.is-filled {
    fill: #fbbc04;
  }

  .google-reviews-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .google-review {
    height: 100%;
    padding: 16px;
    border: 1px solid #dadce0;
    border-radius: 8px;
    background: #fff;
    box-shadow: 0 1px 2px rgba(60, 64, 67, 0.15);
    color: #3c4043;
    font-family: Roboto, Arial, sans-serif;
  }

  .google-review header {
    display: flex;
    gap: 12px;
    align-items: center;
  }

  .google-avatar {
    display: grid;
    flex: 0 0 40px;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    color: #fff;
    font-size: 18px;
    font-weight: 500;
  }

  .google-review-name,
  .google-review-detail,
  .google-review-meta,
  .google-review p {
    margin: 0;
  }

  .google-review-name {
    color: #202124;
    font-size: 14px;
    font-weight: 500;
  }

  .google-review-detail {
    color: #70757a;
    font-size: 12px;
  }

  .google-review-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
    margin: 10px 0 8px;
    color: #70757a;
    font-size: 12px;
  }

  .google-review > p {
    font-size: 14px;
    line-height: 1.45;
  }

  @media (min-width: 800px) {
    .google-reviews-row {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      align-items: stretch;
    }
  }
</style>
