---
import Button from '../atoms/Button/Button.astro';
import site from '../../config/site.json';

const phoneHref = `tel:${site.business.phone.replace(/[^\d+]/g, '')}`;
---

<section class="home-stage" aria-labelledby="home-hero-title">
  <img
    class="home-stage-photo"
    src="/wp-content/uploads/2021/06/IMG_8994-683x1024.jpg"
    alt="A family laughing with cups of shave ice in front of the Minnesnowii trailer"
    width="683"
    height="1024"
  />
  <div class="home-stage-copy">
    <p class="home-kicker">Parties, events and social gatherings</p>
    <h1 id="home-hero-title">What will your guests still be talking about on the drive home?</h1>
    <p class="home-lead">You can fill the room. The harder part is giving people a reason to feel glad they came.</p>
    <div class="home-actions">
      <Button href="/contact/">Plan the moment they remember</Button>
      <a class="home-call" href={phoneHref}>Or call {site.business.phone}</a>
    </div>
  </div>
</section>

<slot />

<style is:global>
  .home-stage {
    position: relative;
    display: grid;
    align-items: end;
    min-height: max(560px, calc(100svh - 180px));
    overflow: hidden;
    color: #fff;
  }

  .home-stage-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .home-stage::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(0, 0, 0, 0.78) 0%, rgba(0, 0, 0, 0.42) 52%, rgba(0, 0, 0, 0.12) 100%);
  }

  .home-stage-copy {
    position: relative;
    z-index: 1;
    max-width: 760px;
    padding: 48px 24px 64px;
  }

  .home-kicker {
    margin: 0 0 12px;
    color: #03d9ff;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .home-stage h1 {
    margin: 0 0 16px;
    color: #fff;
    font-family: var(--font-brand);
    font-size: clamp(32px, 5vw, 58px);
    font-weight: 400;
    line-height: 1.08;
    height: auto;
    text-align: left;
  }

  .home-lead {
    margin: 0 0 24px;
    max-width: 38rem;
    color: #fff;
    font-size: 18px;
    line-height: 1.5;
  }

  .home-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 20px;
    align-items: center;
  }

  .home-call {
    color: #fff;
    font-weight: 700;
  }

  .home-brand {
    background: #fff;
    padding: 0 0 36px;
    text-align: center;
  }

  .home-brand-fade {
    margin: 0 0 4px;
    padding: 4rem 5%;
    background: linear-gradient(180deg, #000 0%, #fff 88px);
  }

  .home-brand-headline,
  .home-brand-subhead {
    margin: 0;
    font-family: var(--font-brand);
    font-weight: 400;
    line-height: 1.15;
    text-align: center;
  }

  .home-brand-headline {
    color: #03d9ff;
    font-size: clamp(2.25rem, 6vw, 4rem);
    text-shadow: 0.15rem 0.15rem 0.25rem #333;
  }

  .home-brand-subhead {
    margin-top: 0.5rem;
    color: var(--color-brand-ink);
    font-size: clamp(1.35rem, 3.5vw, 2.5rem);
  }

  .home-brand > :not(.home-brand-fade) {
    padding-right: 5%;
    padding-left: 5%;
  }

  @media (max-width: 699px) {
    .home-stage {
      min-height: 0;
    }

    .home-stage::after {
      background: linear-gradient(180deg, rgba(0, 0, 0, 0.15) 0%, rgba(0, 0, 0, 0.78) 70%);
    }

    .home-stage-copy {
      padding-top: 28vh;
    }
  }
</style>
