---
import Button from '../atoms/Button/Button.astro';
import site from '../../config/site.json';

interface Props {
  path: string;
}

const { path } = Astro.props;
const primaryLinks = site.navigation.primary;
const aboutLinks = site.navigation.about;
const aboutActive = aboutLinks.some((item) => path === item.href);
const phoneHref = `tel:${site.business.phone.replace(/[^\d+]/g, '')}`;
---

<header id="masthead" class="site-header">
  <a class="skip-link" href="#content">Skip to content</a>
  <div class="site-header-bar">
    <a class="site-logo" href="/" rel="home">
      <img src={site.brand.logo.light} alt="Minnesnowii" width="148" height="78" />
    </a>
    <div class="site-header-actions">
      <div class="site-header-book site-header-book--bar">
        <Button href={phoneHref} title="Book Now">Book Now</Button>
      </div>
      <details class="site-menu">
        <summary class="site-menu-button">
          <span class="sr-only">Menu</span>
          <span class="site-menu-bars" aria-hidden="true"></span>
        </summary>
      </details>
    </div>
    <nav id="site-navigation" class="site-nav" aria-label="Primary">
        <ul id="menu-header-menu">
          {primaryLinks.map((item) => (
            <li class:list={[path === item.href && 'active']}>
              <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a>
            </li>
          ))}
          <li class:list={['about-item', aboutActive && 'active']}>
            <details class="about-menu">
              <summary aria-haspopup="true">About</summary>
              <ul>
                {aboutLinks.map((item) => (
                  <li>
                    <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a>
                  </li>
                ))}
              </ul>
            </details>
          </li>
        </ul>
        <div class="site-header-book site-header-book--menu">
          <Button href={phoneHref} title="Book Now">Book Now</Button>
        </div>
    </nav>
  </div>
</header>

<script is:inline>
  document.querySelectorAll('.about-menu').forEach((menu) => {
    const desktop = window.matchMedia('(min-width: 900px)');
    const summary = menu.querySelector('summary');
    summary.addEventListener('click', (event) => {
      if (desktop.matches) event.preventDefault();
    });
    menu.addEventListener('mouseenter', () => {
      if (desktop.matches) menu.open = true;
    });
    menu.addEventListener('mouseleave', () => {
      if (desktop.matches) menu.open = false;
    });
    menu.addEventListener('focusin', () => {
      if (desktop.matches) menu.open = true;
    });
    menu.addEventListener('focusout', (event) => {
      if (desktop.matches && !menu.contains(event.relatedTarget)) menu.open = false;
    });
  });
</script>

<style>
  #masthead.site-header {
    position: sticky;
    top: 0;
    z-index: 10000;
    width: 100%;
    padding: 0;
    background: #05d9ff;
    background-image: none;
    box-shadow: 0 1px 0 rgba(0, 0, 0, 0.08);
  }

  .skip-link {
    position: absolute;
    left: 16px;
    top: -48px;
    z-index: 2;
    padding: 8px 12px;
    background: #ffffff;
    color: #111111;
    font-size: 14px;
  }

  .skip-link:focus {
    top: 8px;
  }

  .site-header-bar {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    width: 100%;
    padding: 8px 28px;
  }

  .site-logo {
    display: block;
    flex: 0 0 auto;
    line-height: 0;
  }

  .site-logo img {
    display: block;
    width: auto;
    height: 64px;
  }

  .site-header-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 12px;
    justify-self: end;
  }

  .site-header-book .btn {
    white-space: nowrap;
  }

  .site-header-book--menu {
    display: none;
  }

  .site-menu {
    position: relative;
  }

  .site-nav {
    display: none;
  }

  .site-menu-button .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }

  .site-menu-button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    list-style: none;
    cursor: pointer;
  }

  .site-menu-button::-webkit-details-marker {
    display: none;
  }

  .site-menu-bars,
  .site-menu-bars::before,
  .site-menu-bars::after {
    display: block;
    width: 22px;
    height: 2px;
    background: #111111;
    content: "";
  }

  .site-menu-bars {
    position: relative;
  }

  .site-menu-bars::before,
  .site-menu-bars::after {
    position: absolute;
    left: 0;
  }

  .site-menu-bars::before {
    top: -7px;
  }

  .site-menu-bars::after {
    top: 7px;
  }

  #menu-header-menu {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: 0;
    padding: 8px 0 12px;
    list-style: none;
  }

  #menu-header-menu > li > a,
  .about-menu > summary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 4px;
    color: #111111;
    font-family: "Open Sans", sans-serif;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.2;
    text-decoration: none;
    cursor: pointer;
  }

  .about-menu > summary {
    list-style: none;
  }

  .about-menu > summary::-webkit-details-marker {
    display: none;
  }

  .about-menu > summary::after {
    width: 0;
    height: 0;
    border-right: 5px solid transparent;
    border-left: 5px solid transparent;
    border-top: 6px solid currentColor;
    content: "";
  }

  #menu-header-menu a:hover,
  #menu-header-menu a:focus-visible,
  .about-menu > summary:hover,
  .about-menu > summary:focus-visible,
  #menu-header-menu > li.active > a,
  .about-item.active > .about-menu > summary {
    color: #ee292f;
  }

  .about-menu {
    position: relative;
  }

  .about-menu > ul {
    margin: 0;
    padding: 8px 0;
    list-style: none;
    background: #ffffff;
  }

  .about-menu > ul a {
    display: block;
    padding: 10px 16px;
    color: #111111;
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
  }

  .about-menu > ul a:hover,
  .about-menu > ul a:focus-visible,
  .about-menu > ul a[aria-current="page"] {
    color: #ee292f;
  }

  #site-navigation.site-nav {
    min-height: 0;
  }

  @media (max-width: 899px) {
    .site-header-bar {
      position: relative;
    }

    .site-header-actions {
      position: static;
    }

    .site-menu {
      position: static;
    }

    .site-header-bar:has(.site-menu[open]) .site-nav {
      display: block;
      position: absolute;
      top: 100%;
      right: 0;
      left: 0;
      z-index: 2;
      background: #05d9ff;
      padding: 4px 24px 16px;
    }

    .site-header-book--menu {
      display: block;
      margin-top: 12px;
      padding-top: 4px;
    }

    .site-header-book--menu .btn {
      display: block;
      width: 100%;
    }
  }

  @media (min-width: 900px) {
    .site-header-bar {
      grid-template-columns: auto minmax(0, 1fr) auto;
    }

    .site-header-actions {
      display: none;
    }

    .site-nav {
      display: flex;
      align-items: center;
      justify-self: end;
      grid-column: 2 / 4;
      width: max-content;
      min-height: 0;
      gap: 20px;
    }

    .site-header-book--menu {
      display: block;
      flex: 0 0 auto;
    }

    #menu-header-menu {
      display: block;
      width: max-content;
      margin: 0;
      padding: 0;
      white-space: nowrap;
    }

    #menu-header-menu > li {
      display: inline-block;
      margin-left: 28px;
      vertical-align: middle;
      white-space: nowrap;
    }

    #menu-header-menu > li:first-child {
      margin-left: 0;
    }

    .about-menu > ul {
      display: none;
      position: absolute;
      top: 100%;
      right: 0;
      min-width: 180px;
      padding: 8px 0;
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.12);
    }

    .about-menu[open] > ul,
    .about-menu:hover > ul,
    .about-menu:focus-within > ul {
      display: block !important;
    }
  }

  @media (min-width: 900px) and (max-width: 1199px) {
    #menu-header-menu > li {
      margin-left: 16px;
    }

    #menu-header-menu > li > a,
    .about-menu > summary {
      font-size: 14px;
    }

    .site-header-book--menu .btn {
      padding: 12px 16px !important;
      font-size: 14px !important;
    }
  }
</style>
