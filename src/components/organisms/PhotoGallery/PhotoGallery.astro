---
import { instagramPosts } from '../../../data/instagram-posts';

interface Props {
  images?: { src: string; alt: string }[];
}

const { images = instagramPosts } = Astro.props;

function tileSize(src: string, index: number): string {
  let hash = index + 1;
  for (let i = 0; i < src.length; i += 1) {
    hash = (hash * 33 + src.charCodeAt(i)) % 1000;
  }
  const roll = hash % 10;
  if (roll < 2) return 'feature';
  if (roll < 5) return 'tall';
  if (roll < 7) return 'wide';
  return 'regular';
}
---

<ul class="photo-gallery" aria-label="Photo gallery">
  {images.map((image, index) => (
    <li class:list={['photo-tile', `is-${tileSize(image.src, index)}`]}>
      <img src={image.src} alt={image.alt} loading="lazy" width="600" height="600" />
    </li>
  ))}
</ul>

<style>
  .photo-gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .photo-tile {
    overflow: hidden;
    border-radius: 16px;
    background: #f3f3f3;
  }

  .photo-tile img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .is-tall {
    grid-row: span 2;
  }

  .is-wide {
    grid-column: span 2;
  }

  .is-feature {
    grid-column: span 2;
    grid-row: span 2;
  }

  @media (min-width: 900px) {
    .photo-gallery {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 16px;
    }
  }
</style>
