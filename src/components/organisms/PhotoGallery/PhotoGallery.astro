---
import ServerPhotoAlbum from 'react-photo-album/server';
import 'react-photo-album/masonry.css';
import type { GalleryPhoto } from '../../../data/instagram-posts';
import { instagramPosts } from '../../../data/instagram-posts';

interface Props {
  images?: GalleryPhoto[];
}

const { images = instagramPosts } = Astro.props;

function columns(containerWidth: number): number {
  if (containerWidth < 700) return 2;
  if (containerWidth < 1100) return 3;
  return 4;
}

function spacing(containerWidth: number): number {
  return containerWidth < 700 ? 12 : 16;
}
---

<div class="photo-gallery" role="region" aria-label="Photo gallery">
  <ServerPhotoAlbum
    layout="masonry"
    photos={images}
    breakpoints={[360, 700, 1100]}
    columns={columns}
    spacing={spacing}
    componentsProps={{
      image: { loading: 'lazy', decoding: 'async' },
    }}
  />
</div>

<style>
  .photo-gallery {
    width: 100%;
  }

  .photo-gallery :global(.react-photo-album--image) {
    border-radius: 16px;
    background: #f3f3f3;
  }
</style>
