---
interface Props {
  level?: 1 | 2 | 3 | 4;
  class?: string;
  id?: string;
}

const { level = 2, class: className = '', id } = Astro.props;
const Tag = `h${level}` as 'h1' | 'h2' | 'h3' | 'h4';
---

<Tag id={id} class:list={['heading', `heading-${level}`, className]}>
  <slot />
</Tag>

<style>
  .heading {
    margin: 0;
    color: var(--color-brand-ink);
    font-family: var(--font-brand);
    font-weight: 400;
    line-height: 1.15;
  }

  .heading-1 {
    font-size: clamp(2rem, 4vw, 3.25rem);
  }

  .heading-2 {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
  }

  .heading-3 {
    font-size: clamp(1.25rem, 2vw, 1.65rem);
  }

  .heading-4 {
    font-size: 1.125rem;
  }

  .heading.display {
    color: var(--color-brand-cyan-deep);
    text-shadow: 0.15rem 0.15rem 0.25rem #333;
  }
</style>
