---
interface Props {
  id: string;
  name: string;
  label: string;
  required?: boolean;
  placeholder?: string;
  rows?: number;
}

const {
  id,
  name,
  label,
  required = false,
  placeholder,
  rows = 6,
} = Astro.props;
---

<label class="field" for={id}>
  <span class="field-label">{label}{required && <span aria-hidden="true"> *</span>}</span>
  <textarea
    id={id}
    name={name}
    class="field-control"
    required={required}
    placeholder={placeholder}
    rows={rows}
    aria-required={required ? 'true' : undefined}
  ></textarea>
</label>

<style>
  .field {
    display: grid;
    gap: 6px;
  }

  .field-label {
    font-size: 0.9375rem;
    font-weight: 700;
  }

  .field-control {
    width: 100%;
    box-sizing: border-box;
    padding: 12px 14px;
    border: 1px solid #c9c9c9;
    border-radius: 10px;
    font: inherit;
    resize: vertical;
  }

  .field-control:focus-visible {
    outline: 3px solid var(--color-brand-cyan);
    outline-offset: 2px;
  }
</style>
