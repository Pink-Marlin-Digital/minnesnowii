---
interface Props {
  as?: 'p' | 'span' | 'div';
  class?: string;
}

const { as: Tag = 'p', class: className = '' } = Astro.props;
---

<Tag class:list={['text', className]}>
  <slot />
</Tag>

<style>
  .text {
    margin: 0;
    color: var(--color-brand-ink);
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  .text.lead {
    font-size: 1.125rem;
  }

  .text.muted {
    color: #444444;
  }

  .text.center {
    text-align: center;
  }
</style>
