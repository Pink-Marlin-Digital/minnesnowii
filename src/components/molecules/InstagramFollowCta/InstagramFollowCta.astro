---
import SocialIcon from '../../atoms/SocialIcon/SocialIcon.astro';
import site from '../../../config/site.json';

interface Props {
  title: string;
  body: string;
  buttonLabel: string;
}

const { title, body, buttonLabel } = Astro.props;
const instagram = site.social.find((item) => item.platform === 'instagram');
if (!instagram) {
  throw new Error('Instagram URL missing from site config');
}
---

<section class="instagram-follow" aria-labelledby="instagram-follow-title">
  <div class="instagram-follow-icon" aria-hidden="true">
    <SocialIcon platform="instagram" />
  </div>
  <h2 id="instagram-follow-title" class="instagram-follow-title">{title}</h2>
  <p class="instagram-follow-body">{body}</p>
  <a
    class="btn"
    href={instagram.url}
    target="_blank"
    rel="noreferrer"
    title={buttonLabel}
  >
    {buttonLabel}
  </a>
</section>

<style>
  .instagram-follow {
    display: grid;
    gap: 12px;
    justify-items: center;
    padding: 28px 20px;
    text-align: center;
    background: linear-gradient(
      130deg,
      rgb(244, 231, 129) 0%,
      rgb(244, 231, 129) 20%,
      rgb(255, 255, 255) 75%,
      rgb(255, 255, 255) 100%
    );
    border-radius: 1rem;
  }

  .instagram-follow-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    background: #03d9ff;
    color: #0a0a0a;
    box-shadow: 0.15rem 0.15rem 0.25rem #333;
  }

  .instagram-follow-title {
    margin: 0;
    color: #03d9ff;
    font-family: var(--font-brand);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 400;
    line-height: 1.15;
    text-shadow: 0.15rem 0.15rem 0.25rem #333;
  }

  .instagram-follow-body {
    margin: 0 0 8px;
    max-width: 34rem;
    line-height: 1.55;
  }
</style>
